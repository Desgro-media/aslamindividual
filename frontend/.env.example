# Copy to .env.local for local development, and set the same names in
# Vercel -> Project -> Settings -> Environment Variables for production.

# ── Required ────────────────────────────────────────────────────────────────
# A Postgres connection string. On Vercel use the POOLED string from Neon
# (Vercel Marketplace -> Neon) or Supabase — it already ends in ?sslmode=require.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# openssl rand -base64 64   (>= 32 bytes; reuse the old backend's value to keep everyone signed in)
JWT_SECRET=
# The public URL of this deployment, used in emails/SMS links
APP_BASE_URL=https://your-project.vercel.app
# Browser calls the API on the same origin
NEXT_PUBLIC_API_URL=/api/v1

# ── Platform owner (seeded on first request) ────────────────────────────────
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_IP_ALLOWLIST=
PLATFORM_UPI_ID=
PLATFORM_UPI_QR_BASE64=

# ── Optional ────────────────────────────────────────────────────────────────
APP_TIMEZONE=Asia/Kolkata
DB_POOL_MAX=5
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
AI_BASE_URL=https://integrate.api.nvidia.com
AI_API_KEY=
AI_MODEL=mistralai/mistral-medium-3.5-128b
# Vercel rejects request bodies over 4.5 MB, so uploads are capped at ~3 MB there
MAX_ATTACHMENT_BYTES=3145728
